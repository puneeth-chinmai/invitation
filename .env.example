# Supabase Public Configuration for Puneeth & Chinmai Wedding Website
# Copy this file to .env or .env.local and populate with your Supabase Project settings.
# Find these in your Supabase Dashboard: Project Settings -> API.

# Your Supabase Project URL (e.g. https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Public Anon Key (safe to include in client bundles; protected by RLS)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
